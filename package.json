{
  "name": "@h1deya/langchain-google-genai-ex",
  "version": "0.2.5",
  "description": "Drop-in replacement for ChatGoogleGenerativeAI that automatically fixes schema compatibility issues with MCP tools and Gemini API",
  "keywords": [
    "langchain",
    "google",
    "gemini",
    "GoogleGenerativeAI",
    "model context protocol",
    "mcp",
    "tools",
    "function calling",
    "schema",
    "validation",
    "error",
    "400 Error",
    "llm",
    "typescript"
  ],
  "author": "Hideya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideya/langchain-google-genai-ex.git"
  },
  "bugs": {
    "url": "https://github.com/hideya/langchain-google-genai-ex/issues"
  },
  "homepage": "https://github.com/hideya/langchain-google-genai-ex#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:watch": "tsup src/index.ts --format cjs,esm --dts --watch",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "npm run type-check && npm run test:simple",
    "test:basic": "tsx src/test/basic.test.ts",
    "test:simple": "tsx src/test/simple.test.ts",
    "test:individual-servers": "tsx src/test/individual-servers.test.ts",
    "test:integration": "tsx src/test/integration.test.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:all": "git clean -fdxn -e .env && read -p '\nOK? ' && git clean -fdx -e .env",
    "publish:test": "npm run clean:all && npm install && npm run build && npm publish --access=public --dry-run",
    "publish:do": "npm run clean:all && npm install && npm run build && npm publish --access=public",
    "docs:build": "npx typedoc --options typedoc.json",
    "docs:deploy": "npm run docs:build && ghp-import -n -p -f docs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@langchain/google-genai": ">=0.2.16"
  },
  "devDependencies": {
    "@langchain/google-genai": "^2.3.4",
    "@langchain/mcp-adapters": "^1.1.4",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "^16.6.1",
    "eslint": "^10.13.0",
    "langchain": "^1.5.19",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
